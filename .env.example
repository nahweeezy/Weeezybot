# Copy this file to .env and fill it in. Never commit .env or share the token.

# Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Your server's ID (Discord: enable Developer Mode, right-click the server icon → Copy Server ID)
GUILD_ID=

# Developer Portal → your app → General Information → Application ID (only used by `npm run invite`)
CLIENT_ID=

# Optional: keep the live config and database somewhere else, e.g. a persistent disk/volume.
# If CONFIG_PATH doesn't exist yet it is created from the repo's config.json.
# CONFIG_PATH=/data/config.json
# DATABASE_PATH=/data/weeezybot.db

# Optional: log every XP grant
# DEBUG=1
